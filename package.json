{
  "name": "henshin",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm --filter @henshin/server build && pnpm --filter @henshin/desktop build",
    "typecheck": "pnpm -r typecheck",
    "test:http": "vitest run",
    "test:e2e": "playwright test",
    "test": "pnpm build && pnpm test:http && pnpm test:e2e"
  },
  "devDependencies": {
    "@effect/platform-node": "4.0.5",
    "@effect/vitest": "4.0.5",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "effect": "4.0.5",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
