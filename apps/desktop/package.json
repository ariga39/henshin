{
  "name": "@henshin/desktop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node build.mjs && node --test dist/tests/*.test.js",
    "package": "node package.mjs",
    "start": "electron ."
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "44.9.0",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "build": {
    "appId": "com.henshin.desktop",
    "productName": "Henshin",
    "directories": { "output": "../../dist/release" },
    "files": [
      "package.json",
      "dist/main.cjs",
      "dist/preload.cjs",
      "dist/renderer.js",
      "dist/index.html",
      "dist/style.css"
    ],
    "asar": true,
    "npmRebuild": false,
    "nodeGypRebuild": false,
    "mac": { "identity": "-", "target": ["zip"], "artifactName": "Henshin-${version}-darwin-${arch}.${ext}" },
    "win": { "target": ["zip"], "artifactName": "Henshin-${version}-windows-${arch}.${ext}" },
    "linux": { "target": ["AppImage"], "artifactName": "Henshin-${version}-linux-${arch}.${ext}" }
  }
}
